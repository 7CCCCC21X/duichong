# 复制为 .env 并填写。所有密钥只从环境变量读取，日志中会自动脱敏。不要提交 .env。

# 实盘总开关：必须同时满足 config.yaml 中 mode: live 且这里为 true，才会真实下单
LIVE_TRADING=false

# ---------------- Predict（BNB Chain） ----------------
# 主网每个请求都需要 API Key（https://developers.predict.fun 申请）；测试网不需要
PREDICT_API_KEY=
# 签名私钥：EOA 私钥，或在 predict.fun 账户设置中导出的 Privy 钱包私钥
PREDICT_SIGNER_PRIVATE_KEY=
# 使用 Predict 账户（智能钱包 / 充值地址）时填写其地址；使用 EOA 交易时留空
PREDICT_ACCOUNT_ADDRESS=

# ---------------- Polymarket（Polygon） ----------------
# 账户 signer 私钥
POLYMARKET_PRIVATE_KEY=
# 账户钱包地址（资金地址：Deposit Wallet / Proxy / Safe）；留空则按 SDK 默认的 Deposit Wallet 流程
POLYMARKET_WALLET_ADDRESS=
# 可选：已有的 CLOB L2 凭证；留空则由 SDK 自动派生或创建
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
# 可选：Relayer API Key（免 gas 钱包操作，例如授权）
POLYMARKET_RELAYER_API_KEY=
POLYMARKET_RELAYER_API_KEY_ADDRESS=

# ---------------- 运维 ----------------
# 可选：告警 webhook（收到 JSON：level/code/pairId/message/time/text）
ALERT_WEBHOOK_URL=
# 可选：保护状态页 API（访问 /api/status?token=...）
STATUS_TOKEN=

# 若机器需通过代理访问外网：启动时设置 NODE_USE_ENV_PROXY=1 让 fetch 使用 HTTPS_PROXY（WebSocket 会自动使用）
# HTTPS_PROXY=http://127.0.0.1:7890
